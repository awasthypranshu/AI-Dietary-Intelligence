# ==============================================================================
# AI Dietary Intelligence - Master Environment Variables Configuration
# ==============================================================================
# This project contains two main subdirectories:
#   1. server/  - Express + MySQL + Google Gemini AI backend
#   2. client/  - Vite + React frontend
#
# Follow the instructions below to configure each component.
# ==============================================================================

# ==========================================
# 1. SERVER CONFIGURATION (server/.env)
# ==========================================
# Server Port & CORS
PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Google Gemini API Key (REQUIRED)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Connection (MySQL / MariaDB) (REQUIRED)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dietaryAI

# Email Service (SMTP) (OPTIONAL - FOR PASSWORD RESET)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================================
# 2. CLIENT CONFIGURATION (client/.env)
# ==========================================
# Points the Vite frontend to the Express backend API
VITE_API_URL=http://localhost:5001

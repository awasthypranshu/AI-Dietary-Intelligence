# ==============================================================================
# AI Dietary Intelligence - Client (Frontend) Environment Variables
# ==============================================================================
# Copy this file to '.env' in the client folder.
# Command: cp .env.example .env (or copy .env.example .env on Windows)
# ==============================================================================

# Backend API Base URL
# This is the full URL where your Express backend server is running.
# In local development, the backend runs on port 5001 by default.
# Note: Vite requires environment variables exposed to the browser to be prefixed with 'VITE_'.
VITE_API_URL=http://localhost:5001

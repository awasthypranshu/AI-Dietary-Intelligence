# ==============================================================================
# AI Dietary Intelligence - Server Environment Variables & API Configuration
# ==============================================================================
# Copy this file to '.env' in the same folder and fill in your values.
# Command: cp .env.example .env (or copy .env.example .env on Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# The port the Node.js/Express server listens on (default: 5001)
PORT=5001

# The URL where the frontend (Vite React app) is hosted.
# Used by Express CORS middleware to allow credentials/cookies from the client.
CLIENT_URL=http://localhost:5173

# Environment mode: 'development' or 'production'
NODE_ENV=development


# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (REQUIRED)
# ------------------------------------------------------------------------------
# Required for:
#   - Food recognition from uploaded photos
#   - Automated ingredient classification (visible, suspected, traditional)
#   - Serving size & macronutrient estimation
#   - Agent 1: Personal Context Agent (Agentic RAG with function calling)
#   - Agent 2: Food Variant Agent (culinary differences & nutrition direction)
#   - Agent 3: Personalized Verdict Agent (safety evaluation & allergy guard)
#
# How to get your API key:
#   1. Visit Google AI Studio: https://aistudio.google.com/app/apikey
#   2. Sign in with your Google account.
#   3. Click "Create API Key" (choose or create a Google Cloud project).
#   4. Copy the generated key and paste it below.
#
# Free tier gives generous rate limits (up to 15 RPM on Flash models).
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name:
# Recommended models:
#   - gemini-2.5-flash (fast, high-quality multimodal reasoning, low latency)
#   - gemini-1.5-flash (standard stable production model)
#   - gemini-1.5-pro   (complex medical reasoning, slightly higher latency)
GEMINI_MODEL=gemini-2.5-flash


# ------------------------------------------------------------------------------
# 3. RELATIONAL DATABASE (MYSQL / MARIADB) (REQUIRED)
# ------------------------------------------------------------------------------
# The system stores user accounts, sessions, patient health profiles, medical
# reports, food image history, digital twin logs, food genomes, and the shared
# culinary knowledge catalog in MySQL.
#
# Setup steps:
#   1. Install MySQL Server, MariaDB, or XAMPP (or run MySQL in Docker).
#   2. In MySQL terminal or phpMyAdmin, create the database:
#        CREATE DATABASE dietaryAI;
#   3. Run the migrations to build all tables:
#        npm run migrate
#   4. (Optional) Seed the verified food knowledge catalog:
#        npm run seed:knowledge
#
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dietaryAI


# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (SMTP) (OPTIONAL)
# ------------------------------------------------------------------------------
# Used by Nodemailer to deliver password reset tokens to users' email addresses.
# If left blank, password reset endpoints will log warnings instead of sending.
#
# For Gmail:
#   - Host: smtp.gmail.com
#   - Port: 587 (or 465 for SSL)
#   - User: your-gmail-address@gmail.com
#   - Password: An App Password generated from https://myaccount.google.com/apppasswords
#               (Do NOT use your normal Gmail login password!)
#   - From: "AI Dietary Intelligence <your-gmail-address@gmail.com>"
#
# For Ethereal (local testing without real emails):
#   - Generate free test credentials at https://ethereal.email/
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
